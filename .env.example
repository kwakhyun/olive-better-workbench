# 행사 가이드에서 제공하는 OpenAI 호환 LLM 연결 정보를 입력하세요.
LLM_API_URL=https://your-event-llm.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=

# 선택: 행사 연결이 별도 인증 헤더를 요구할 때 사용합니다.
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer

# 선택: 공개 트렌드 소스 프록시나 테스트 서버를 사용할 때만 재정의하세요.
TREND_RSS_URL=
TREND_OPENALEX_URL=
TREND_EUROPEPMC_URL=

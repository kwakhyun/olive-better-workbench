# 로컬 개발에는 필수 환경변수가 없습니다. 대표 배너는 앱 안의 안전 카피 엔진이 생성합니다.

# 프로덕션 필수: 운영 화면과 쓰기 API를 사용할 MD 계정 이메일입니다.
# 여러 명이면 쉼표로 구분합니다. 값은 배포 환경에만 저장하고 저장소에 커밋하지 마세요.
OPERATOR_EMAILS=

# 선택: 공개 트렌드 소스 프록시나 테스트 서버를 사용할 때만 재정의하세요.
TREND_RSS_URL=
TREND_OPENALEX_URL=
TREND_EUROPEPMC_URL=

# 선택: 네트워크 없는 테스트 자료를 사용하려면 true로 설정하세요.
TEST_CONNECTORS=false
